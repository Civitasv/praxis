{
  "name": "praxis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p plugins/dsh/tsconfig.json --pretty false",
    "test:dsh": "node --experimental-strip-types --test plugins/dsh/test/*.test.ts",
    "check:dsh": "pnpm typecheck && pnpm test:dsh"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1"
  },
  "exports": {
    ".": "./plugins/dsh/src/index.ts"
  },
  "dsh": {
    "bundle": {
      "patch": "./plugins/dsh/cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2 || 0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "license": "AGPL-3.0-only"
}
